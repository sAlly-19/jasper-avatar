{
  "name": "jasper-avatar",
  "version": "1.0.0",
  "description": "Jasper - Interactive 3D Voice Assistant with Three.js and Gemini Live",
  "author": "Jasper Team",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/run-tests.mjs",
    "capture:showcase": "node scripts/capture-showcase.cjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^3.21.0",
    "dotenv": "^16.4.7",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "electron": "44.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
